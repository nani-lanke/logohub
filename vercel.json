{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "functions": {
    "api/brand.js": { "includeFiles": "companies.js" },
    "api/sitemap.js": { "includeFiles": "companies.js" }
  },

  "crons": [
    { "path": "/api/expire", "schedule": "30 3 * * *" }
  ],

  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true }
  ],

  "rewrites": [
    { "source": "/brand/:slug", "destination": "/api/brand?slug=:slug" },
    { "source": "/brands", "destination": "/api/brand" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ]
}
